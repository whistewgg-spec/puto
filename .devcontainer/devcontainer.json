{
  "name": "Virtual PC",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true,
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "version": "latest",
      "password": "virtual123",
      "webPort": "6080",
      "vncPort": "5901"
    }
  },
  "forwardPorts": [6080, 5901, 8006, 3389],
  "portsAttributes": {
    "6080": {
      "label": "Desktop Linux (noVNC)",
      "onAutoForward": "silent",
      "visibility": "public"
    },
    "5901": {
      "label": "VNC",
      "onAutoForward": "silent",
      "visibility": "public"
    },
    "8006": {
      "label": "Desktop Windows (noVNC)",
      "onAutoForward": "silent",
      "visibility": "public"
    },
    "3389": {
      "label": "Windows RDP",
      "onAutoForward": "silent",
      "visibility": "public"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "remoteUser": "root",
  "runArgs": ["--privileged", "--device=/dev/kvm"]
}